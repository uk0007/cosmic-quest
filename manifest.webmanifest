{
  "name": "Cosmic Quest IQ",
  "short_name": "Cosmic Quest",
  "description": "Embark on an epic cosmic adventure across planetary sectors with Cosmo Dog! Solve Olympiad challenges, conquer knowledge gates, and power up!",
